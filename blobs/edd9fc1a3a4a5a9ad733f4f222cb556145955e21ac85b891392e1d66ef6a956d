import { mkdtempSync, writeFileSync, readFileSync, rmSync, existsSync } from "node:fs";
import { tmpdir } from "node:os";
import { execSync } from "node:child_process";
import { join } from "node:path";
import { git } from "./git.js";
import { labelsFromRanges, type CharRange, type LedgerEvent } from "./ledger.js";
import { commonPrefixLength, commonSuffixLength, type ToolCall } from "./capture.js";
import { buildChainedEvent, type CaptureSnapshot, type ChainMethod } from "./chain.js";
import { tokenize } from "./tokenize.js";
import { buildBashEvents, diffLines, type BashFileChange } from "./bash-capture.js";
import { snapshotWorktree, changedFilesBetween, fileInTree } from "./worktree-snapshot.js";
import { rollupByLine, type LineProvenance } from "./lines.js";

export type Actor = "ai" | "human";

interface TrackedFile {
  content: string;
  truth: boolean[];
}

type Model = Map<string, TrackedFile>;

export interface HumanEdit {
  readonly file: string;
  readonly oldString: string;
  readonly newString: string;
}

export class SimulatedRepo {
  readonly dir: string;
  readonly events: LedgerEvent[] = [];
  readonly chainMethods: ChainMethod[] = [];
  private readonly snapshots = new Map<string, CaptureSnapshot>();
  private readonly branchModels = new Map<string, Model>();
  private currentBranch = "main";
  private model: Model = new Map();
  private eventCounter = 0;

  constructor() {
    this.dir = mkdtempSync(join(tmpdir(), "codeprov-history-"));
    this.git(["init", "-q", "-b", "main"]);
    this.git(["config", "user.email", "simulator@example.com"]);
    this.git(["config", "user.name", "Simulator"]);
    this.git(["config", "commit.gpgsign", "false"]);
  }

  git(args: string[]): string {
    return git(this.dir, args);
  }

  dispose(): void {
    rmSync(this.dir, { recursive: true, force: true });
  }

  write(actor: Actor, file: string, content: string): void {
    this.model.set(file, { content, truth: new Array<boolean>(content.length).fill(actor === "ai") });
    writeFileSync(join(this.dir, file), content);
    if (actor === "ai") {
      this.capture(file, content, { toolName: "Write", toolInput: { file_path: file, content } });
    }
  }

  edit(actor: Actor, file: string, oldString: string, newString: string): void {
    this.applyToModel(actor, { file, oldString, newString });
    const content = this.model.get(file)!.content;
    writeFileSync(join(this.dir, file), content);
    if (actor === "ai") {
      this.capture(file, content, {
        toolName: "Edit",
        toolInput: { file_path: file, old_string: oldString, new_string: newString },
      });
    }
  }

  bash(author: Actor, command: string, duringCommand?: () => void): void {
    const beforeTree = snapshotWorktree(this.dir);
    duringCommand?.();
    execSync(command, { cwd: this.dir, shell: "/bin/bash", stdio: "ignore" });
    const afterTree = snapshotWorktree(this.dir);

    const changes: BashFileChange[] = [];
    for (const changed of changedFilesBetween(this.dir, beforeTree, afterTree)) {
      const after = fileInTree(this.dir, afterTree, changed.path);
      changes.push({
        path: changed.path,
        before: changed.status === "added" ? "" : fileInTree(this.dir, beforeTree, changed.path),
        after,
      });
      this.updateTruthFromDisk(author, changed.path, after);
    }

    const captured = buildBashEvents({
      command,
      changes,
      tool: "claude-code",
      model: "simulated",
      previousFor: (file) => this.snapshots.get(file) ?? null,
      identity: () => this.nextIdentity(),
    });
    for (const { event, method, content } of captured) {
      this.events.push(event);
      this.chainMethods.push(method);
      this.snapshots.set(event.file, { content, fileAiRanges: event.fileAiRanges ?? event.aiRanges });
    }
  }

  commit(message: string): void {
    this.git(["add", "-A"]);
    this.git(["commit", "-q", "-m", message]);
  }

  amend(): void {
    this.git(["add", "-A"]);
    this.git(["commit", "-q", "--amend", "--no-edit"]);
  }

  squashSince(baseRev: string, message: string): void {
    this.git(["reset", "-q", "--soft", baseRev]);
    this.git(["commit", "-q", "-m", message]);
  }

  head(): string {
    return this.git(["rev-parse", "HEAD"]).trim();
  }

  createBranch(name: string): void {
    this.branchModels.set(this.currentBranch, cloneModel(this.model));
    this.git(["checkout", "-q", "-b", name]);
    this.currentBranch = name;
  }

  checkout(name: string): void {
    this.branchModels.set(this.currentBranch, cloneModel(this.model));
    this.git(["checkout", "-q", name]);
    this.model = cloneModel(this.branchModels.get(name) ?? new Map());
    this.currentBranch = name;
  }

  rebaseOnto(upstream: string, upstreamEditsToSharedFiles: readonly HumanEdit[]): void {
    this.git(["rebase", "-q", upstream]);
    const upstreamModel = this.branchModels.get(upstream) ?? new Map();
    for (const [file, tracked] of upstreamModel) {
      if (!this.model.has(file)) this.model.set(file, { content: tracked.content, truth: [...tracked.truth] });
    }
    for (const edit of upstreamEditsToSharedFiles) this.applyToModel("human", edit);
    this.assertModelMatchesDisk();
  }

  trackedFiles(): string[] {
    return [...this.model.keys()].sort();
  }

  truthLines(file: string): LineProvenance[] {
    const tracked = this.model.get(file)!;
    const labels = labelsFromRanges(tracked.content, rangesFromTruth(tracked.truth));
    const tokens = tokenize(tracked.content).map((token, index) => ({ ...token, ai: labels[index]! }));
    return rollupByLine(tracked.content, tokens);
  }

  assertModelMatchesDisk(): void {
    for (const [file, tracked] of this.model) {
      const path = join(this.dir, file);
      const onDisk = existsSync(path) ? readFileSync(path, "utf8") : "";
      if (onDisk !== tracked.content) {
        throw new Error(`Simulation model diverged from disk for ${file} on branch ${this.currentBranch}`);
      }
    }
  }

  private applyToModel(actor: Actor, edit: HumanEdit): void {
    const tracked = this.model.get(edit.file);
    if (!tracked) throw new Error(`Unknown file ${edit.file}`);
    const start = tracked.content.indexOf(edit.oldString);
    if (start === -1 || tracked.content.indexOf(edit.oldString, start + 1) !== -1) {
      throw new Error(`Edit target must occur exactly once in ${edit.file}: ${JSON.stringify(edit.oldString)}`);
    }
    const prefix = commonPrefixLength(edit.oldString, edit.newString);
    const suffix = commonSuffixLength(edit.oldString, edit.newString, prefix);
    const changedLength = edit.newString.length - prefix - suffix;
    tracked.content =
      tracked.content.slice(0, start) + edit.newString + tracked.content.slice(start + edit.oldString.length);
    tracked.truth = [
      ...tracked.truth.slice(0, start + prefix),
      ...new Array<boolean>(changedLength).fill(actor === "ai"),
      ...tracked.truth.slice(start + edit.oldString.length - suffix),
    ];
  }

  private nextIdentity(): { id: string; ts: string } {
    this.eventCounter++;
    return {
      id: `event-${this.eventCounter}`,
      ts: new Date(Date.UTC(2026, 9, 2, 0, 0, this.eventCounter)).toISOString(),
    };
  }

  private updateTruthFromDisk(author: Actor, file: string, after: string): void {
    const tracked = this.model.get(file) ?? { content: "", truth: [] };
    const beforeLines = lineSpans(tracked.content);
    const afterLines = lineSpans(after);
    const hunks = diffLines(
      beforeLines.map((line) => line.text),
      afterLines.map((line) => line.text),
    );

    const truth = new Array<boolean>(after.length).fill(false);
    const copyLine = (beforeIndex: number, afterIndex: number): void => {
      const source = beforeLines[beforeIndex]!;
      const target = afterLines[afterIndex]!;
      for (let offset = 0; offset < target.text.length; offset++) {
        truth[target.start + offset] = tracked.truth[source.start + offset]!;
      }
    };

    const changedBefore = new Set<number>();
    const changedAfter = new Set<number>();
    const removedByText = new Map<string, number[]>();
    for (const hunk of hunks) {
      hunk.added.forEach((index) => changedAfter.add(index));
      for (const index of hunk.removed) {
        changedBefore.add(index);
        const text = beforeLines[index]!.text.trim();
        if (text === "") continue;
        removedByText.set(text, [...(removedByText.get(text) ?? []), index]);
      }
    }
    const unchangedBefore = beforeLines.map((_, index) => index).filter((index) => !changedBefore.has(index));
    const unchangedAfter = afterLines.map((_, index) => index).filter((index) => !changedAfter.has(index));
    unchangedAfter.forEach((afterIndex, position) => copyLine(unchangedBefore[position]!, afterIndex));

    for (const hunk of hunks) {
      const paired = hunk.removed.length === hunk.added.length;
      hunk.added.forEach((afterIndex, position) => {
        const target = afterLines[afterIndex]!;
        const movedFrom = removedByText.get(target.text.trim())?.shift();
        if (movedFrom !== undefined && beforeLines[movedFrom]!.text === target.text) {
          copyLine(movedFrom, afterIndex);
          return;
        }
        if (paired) {
          const source = beforeLines[hunk.removed[position]!]!;
          const prefix = commonPrefixLength(source.text, target.text);
          const suffix = commonSuffixLength(source.text, target.text, prefix);
          for (let offset = 0; offset < target.text.length; offset++) {
            const inHead = offset < prefix;
            const inTail = offset >= target.text.length - suffix;
            const sourceOffset = inTail ? source.text.length - (target.text.length - offset) : offset;
            truth[target.start + offset] = inHead || inTail ? tracked.truth[source.start + sourceOffset]! : author === "ai";
          }
          return;
        }
        for (let offset = 0; offset < target.text.length; offset++) truth[target.start + offset] = author === "ai";
      });
    }

    this.model.set(file, { content: after, truth });
  }

  private capture(file: string, content: string, call: ToolCall): void {
    const identity = this.nextIdentity();
    const captured = buildChainedEvent({
      call,
      content,
      file,
      tool: "claude-code",
      model: "simulated",
      previous: this.snapshots.get(file) ?? null,
      id: identity.id,
      ts: identity.ts,
    });
    if (captured === null) return;
    this.events.push(captured.event);
    this.chainMethods.push(captured.method);
    this.snapshots.set(file, { content, fileAiRanges: captured.event.fileAiRanges ?? captured.event.aiRanges });
  }
}

export function deltaOnlyLedger(events: readonly LedgerEvent[]): LedgerEvent[] {
  return events.map(({ fileAiRanges: _ignored, ...rest }) => rest);
}

function rangesFromTruth(truth: readonly boolean[]): CharRange[] {
  const ranges: CharRange[] = [];
  let start = -1;
  for (let index = 0; index <= truth.length; index++) {
    const isAi = index < truth.length && truth[index]!;
    if (isAi && start === -1) start = index;
    if (!isAi && start !== -1) {
      ranges.push([start, index]);
      start = -1;
    }
  }
  return ranges;
}

function lineSpans(content: string): { text: string; start: number }[] {
  const spans: { text: string; start: number }[] = [];
  let start = 0;
  for (const text of content.split("\n")) {
    spans.push({ text, start });
    start += text.length + 1;
  }
  return spans;
}

function cloneModel(model: Model): Model {
  const copy: Model = new Map();
  for (const [file, tracked] of model) copy.set(file, { content: tracked.content, truth: [...tracked.truth] });
  return copy;
}
